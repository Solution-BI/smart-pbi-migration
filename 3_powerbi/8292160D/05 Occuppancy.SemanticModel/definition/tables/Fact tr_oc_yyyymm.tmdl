	/// MicroStrategy metric %LM. Created in the MicroStrategy dashboard as (([Occupancy] - [Occupancy (LM)]) / [Occupancy (LM)]) (read from the .mstr export).
	measure %LM = DIVIDE(([Occupancy (Metric)] - [Occupancy (LM)]), [Occupancy (LM)])
