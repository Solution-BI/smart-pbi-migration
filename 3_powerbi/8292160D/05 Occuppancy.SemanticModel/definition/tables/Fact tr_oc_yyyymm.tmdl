/// Fact table public.tr_oc_yyyymm, aggregated by the MicroStrategy cube SQL
table 'Fact tr_oc_yyyymm'
	lineageTag: 31dc852a-f6e4-46ed-bade-23b1bc824254

	/// MicroStrategy metric SQM (Occupied). MicroStrategy base metric: sum of fact 'SQM Occupied' = CASE WHEN id_is_occupancy IN (2, 3) THEN 0 ELSE mt_ge_sqm END on tr_oc_yyyymm.
	measure 'SQM (Occupied)' = SUMX('Fact tr_oc_yyyymm', IF('Fact tr_oc_yyyymm'[id_is_occupancy] IN {2, 3}, 0, 'Fact tr_oc_yyyymm'[mt_ge_sqm]))
		isHidden
		lineageTag: a52e5dc6-cfbb-428e-be6a-5de3cd7cdefa

	/// MicroStrategy metric SQM. MicroStrategy base metric: sum of fact 'SQM' = mt_ge_sqm on tr_oc_yyyymm.
	measure SQM = SUM('Fact tr_oc_yyyymm'[mt_ge_sqm])
		isHidden
		lineageTag: 54250a5f-2d77-4bdc-8cef-30f4f22622f0

	/// MicroStrategy metric SQM (Occupied) (LM). MicroStrategy base metric: sum of fact 'SQM Occupied' = CASE WHEN id_is_occupancy IN (2, 3) THEN 0 ELSE mt_ge_sqm END on tr_oc_yyyymm. MicroStrategy transformation: joins tr_oc_yyyymm.id_tm_yyyymm to lu_tm_yyyymm.id_tm_yyyymm_pv, rebuilt as the periods in 'Dim Year Month'[id_tm_yyyymm_pv] of the periods in context.
	measure 'SQM (Occupied) (LM)' =
			CALCULATE(
			    SUMX('Fact tr_oc_yyyymm', IF('Fact tr_oc_yyyymm'[id_is_occupancy] IN {2, 3}, 0, 'Fact tr_oc_yyyymm'[mt_ge_sqm])),
			    REMOVEFILTERS('Dim Year Month'),
			    TREATAS(VALUES('Dim Year Month'[id_tm_yyyymm_pv]), 'Fact tr_oc_yyyymm'[id_tm_yyyymm])
			)
		isHidden
		lineageTag: b656ff6b-1957-4f03-aee1-3d8674f271c3

	/// MicroStrategy metric SQM (LM). MicroStrategy base metric: sum of fact 'SQM' = mt_ge_sqm on tr_oc_yyyymm. MicroStrategy transformation: joins tr_oc_yyyymm.id_tm_yyyymm to lu_tm_yyyymm.id_tm_yyyymm_pv, rebuilt as the periods in 'Dim Year Month'[id_tm_yyyymm_pv] of the periods in context.
	measure 'SQM (LM)' =
			CALCULATE(
			    SUM('Fact tr_oc_yyyymm'[mt_ge_sqm]),
			    REMOVEFILTERS('Dim Year Month'),
			    TREATAS(VALUES('Dim Year Month'[id_tm_yyyymm_pv]), 'Fact tr_oc_yyyymm'[id_tm_yyyymm])
			)
		isHidden
		lineageTag: 15f9ebc2-d68c-4750-91b8-9eea8f459370

