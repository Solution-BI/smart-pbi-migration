	/// MicroStrategy metric Rent. MicroStrategy base metric: sum of fact 'Rent (RCY)' = (mt_oc_rent * mt_is_reporting_currency) on tr_oc_yyyymm.
	measure Rent = SUMX('Fact tr_oc_yyyymm', 'Fact tr_oc_yyyymm'[mt_oc_rent] * 'Fact tr_oc_yyyymm'[mt_is_reporting_currency])
		isHidden
