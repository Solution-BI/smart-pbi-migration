	/// MicroStrategy metric Sales Value. MicroStrategy base metric: sum of fact 'Sales Value (RCY)' = (mt_is_reporting_currency * mt_sa_value) on tr_oc_yyyymm.
	measure 'Sales Value' = SUMX('Fact tr_oc_yyyymm', 'Fact tr_oc_yyyymm'[mt_is_reporting_currency] * 'Fact tr_oc_yyyymm'[mt_sa_value])
